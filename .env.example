# Copie este archivo como ".env" y cambie TODOS los valores antes de desplegar.
DB_NAME=guali_db
DB_USER=guali
DB_PASSWORD=cambie-esta-clave
DB_ROOT_PASSWORD=cambie-esta-clave-root

# Secreto compartido entre guali-web y guali-compiler (cadena larga y aleatoria)
GUALI_TOKEN_INTERNO=cambie-este-token-largo-y-aleatorio

# Administrador que se crea la primera vez (luego se gestiona desde /admin)
GUALI_ADMIN_USUARIO=admin
GUALI_ADMIN_PASSWORD=Cambie-Esta-Clave-123
